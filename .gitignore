# Готові файли продуктів не зберігаємо в публічному репозиторії — вони відтворюються з build.py
products/*/dist/
products/*/listing/raw/
__pycache__/
*.pyc
# Секрети / токени платформ — ніколи не комітити
.secrets/
*.token
etsy_tokens.json

# Ручний набір для завантаження на Etsy містить платні файли
_upload_kit/
